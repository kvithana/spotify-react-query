{
  "name": "spotify-react-query",
  "version": "1.0.0",
  "description": "React Query hooks for the Spotify Web API",
  "keywords": [
    "spotify",
    "spotify-web-api",
    "react",
    "react-query",
    "tanstack-query",
    "hooks",
    "dataloader"
  ],
  "homepage": "https://github.com/kvithana/spotify-react-query#readme",
  "bugs": {
    "url": "https://github.com/kvithana/spotify-react-query/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvithana/spotify-react-query.git"
  },
  "author": "Kalana Vithana <hello@kalana.io>",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf ./dist && rollup --config rollup.config.ts --configPlugin typescript",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dataloader": "^2.2.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tanstack/react-query": "^5.100.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "@types/spotify-web-api-node": "^5.0.11",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jest": "^30.0.0",
    "np": "^11.2.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.0",
    "rollup": "^4.60.3",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "ts-jest": "^29.4.9",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
